# LLM access (OpenRouter is OpenAI-compatible)
OPENROUTER_API_KEY=

# Local PostgreSQL credentials for Docker Compose (development defaults)
POSTGRES_USER=bedmed
POSTGRES_PASSWORD=bedmed
POSTGRES_DB=bedmed

# Optional: override the default model (any OpenRouter model that supports structured outputs)
BEDMED_MODEL=

# Optional: override the embedding model used for policy retrieval
BEDMED_EMBEDDING_MODEL=
